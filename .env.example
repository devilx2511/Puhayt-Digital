# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_SITE_URL: The canonical production URL where this website is hosted (e.g. https://yourdomain.com).
# Set VITE_SITE_URL and SITE_URL when connecting a custom domain to automatically update canonicals, sitemap.xml, robots.txt, OpenGraph, and JSON-LD.
APP_URL="https://puhaytdigital.ai.studio"
SITE_URL="https://puhaytdigital.ai.studio"
VITE_SITE_URL="https://puhaytdigital.ai.studio"

# Google Cloud reCAPTCHA Enterprise
RECAPTCHA_PROJECT_ID="puhayt-digital"
RECAPTCHA_SITE_KEY="6LePj9UtAAAAAC1nRT_ORs0b94_h2LDouwAP53nL"

