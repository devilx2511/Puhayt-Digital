rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidMapPayload() {
      return request.resource.data is map && request.resource.data.keys().size() <= 50;
    }

    // Leads / Consultation Inquiries
    match /leads/{leadId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && leadId.size() <= 128;
      allow delete: if true;
    }

    // SEO audits collection
    match /seo_audits/{auditId} {
      allow read: if true;
      allow write: if isValidMapPayload() && auditId.size() <= 128;
    }

    // Pricing plans collection (Publicly readable, synced via DevMode)
    match /pricing_plans/{planId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && planId.size() <= 128;
      allow delete: if true;
    }

    // Portfolio projects collection (Publicly readable, synced via DevMode)
    match /portfolio_projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && projectId.size() <= 128;
      allow delete: if true;
    }

    // Marketing campaigns collection
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && campaignId.size() <= 128;
      allow delete: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && notificationId.size() <= 128;
      allow delete: if true;
    }

    // Settings collection (brand_logo, contact_info, location_pin, team_members, discounts, blog_posts, public_reviews, site_config)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && settingId.size() <= 128;
      allow delete: if false;
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && userId.size() <= 128;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Client Assigned Websites (sent from DevMode to paid & subscribed users)
    match /client_websites/{websiteId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && websiteId.size() <= 128;
      allow delete: if true;
    }

    // Client Projects & Sprints
    match /client_projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && projectId.size() <= 128;
      allow delete: if true;
    }

    // Direct Chat between DevMode and Clients
    match /client_chats/{messageId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && messageId.size() <= 128;
      allow delete: if true;
    }

    // Client Invoices & Receipts
    match /client_invoices/{invoiceId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && invoiceId.size() <= 128;
      allow delete: if false;
    }

    // Website Analyses
    match /website_analyses/{analysisId} {
      allow read: if true;
      allow create, update: if isValidMapPayload() && analysisId.size() <= 128;
      allow delete: if true;
    }

    // System Metadata
    match /system_metadata/{metaId} {
      allow read: if true;
      allow write: if isValidMapPayload() && metaId.size() <= 128;
    }

    // Test doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
